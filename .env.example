# Public URL of onegit (used for links, clone URLs and OIDC redirects).
ONEGIT_BASE_URL=http://localhost:3000
ONEGIT_HTTP_PORT=3000
ONEGIT_REPO_NAME=monorepo
# Anonymous browsing and cloning.
ONEGIT_PUBLIC_READ=false
# Set to true behind a reverse proxy, so login rate limits see client IPs.
ONEGIT_TRUST_PROXY=false
# Image to run (docker compose up -d --build builds it from source instead).
ONEGIT_IMAGE=emmtvv/onegit:latest

# Initial admin. Created on first start only; the password must be changed
# at first login.
ONEGIT_ADMIN_USERNAME=admin
ONEGIT_ADMIN_EMAIL=
ONEGIT_ADMIN_PASSWORD=change-me-now

# Backing services.
# Postgres: the bundled container uses these to create the database; to use an
# external server set POSTGRES_HOST/PORT (and POSTGRES_SSL_MODE=require or
# verify-full) and drop the postgres service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=onegit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onegit
POSTGRES_SSL_MODE=disable
REDIS_PASSWORD=change-me
S3_ACCESS_KEY=onegit
S3_SECRET_KEY=change-me-too

# Encrypts deploy secrets in the database. Set it to a long random string and
# keep it outside the database backups; changing it makes secrets unreadable.
ONEGIT_SECRET_KEY=

# Container registry (docker login <host of ONEGIT_BASE_URL>). Size limits
# accept "500MiB", "10GB" or bytes; empty = unlimited.
ONEGIT_REGISTRY_ENABLED=true
ONEGIT_REGISTRY_MAX_BLOB_SIZE=
ONEGIT_REGISTRY_MAX_TOTAL_SIZE=

# Optional SSO (OIDC).
ONEGIT_OIDC_ENABLED=false
ONEGIT_OIDC_DISPLAY_NAME=Keycloak
ONEGIT_OIDC_ISSUER=
ONEGIT_OIDC_CLIENT_ID=
ONEGIT_OIDC_CLIENT_SECRET=
ONEGIT_OIDC_ADMIN_GROUP=
ONEGIT_OIDC_WRITE_GROUP=
